# ─────────────────────────────────────────────────────────────
# Materia Etrusca — variabili d'ambiente
# Copia questo file in .env.local e valorizza ciò che ti serve.
# Il progetto compila anche senza chiavi: le singole funzioni
# falliscono con un messaggio esplicito solo quando le usi.
# ─────────────────────────────────────────────────────────────

# --- Base ---------------------------------------------------
# URL pubblico del sito, senza slash finale. In locale: http://localhost:3000
# Se la lasci vuota su Vercel viene usato il dominio dell'anteprima, così il
# primo deploy funziona anche prima di aver collegato il dominio vero.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Lingua servita. Per ora solo "it" ("en" è predisposto ma non pubblicato).
NEXT_PUBLIC_DEFAULT_LOCALE="it"

# --- Database (PostgreSQL) ----------------------------------
# Stringa di connessione. Su Neon/Supabase usa la connessione "pooled".
DATABASE_URL="postgresql://utente:password@localhost:5432/materia_etrusca"

# --- Auth.js (magic link via email) -------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET=""
# In produzione dietro proxy (Vercel lo imposta da sé)
AUTH_TRUST_HOST="true"
# Email autorizzate a entrare nel pannello /admin, separate da virgola
ADMIN_EMAILS="artigiano@materiaetrusca.it"

# --- Email transazionali (Resend) ---------------------------
RESEND_API_KEY=""
# Mittente verificato su Resend
EMAIL_FROM="Materia Etrusca <ciao@materiaetrusca.it>"
# Dove arrivano le notifiche interne (nuovo ordine, nuova richiesta progetto)
ARTISAN_EMAIL="artigiano@materiaetrusca.it"

# --- Stripe --------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Segreto del webhook: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# --- PayPal --------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" oppure "live"
PAYPAL_ENVIRONMENT="sandbox"
# Id del webhook creato nel pannello PayPal (serve a verificarne la firma)
PAYPAL_WEBHOOK_ID=""

# --- Upload immagini (Uploadthing) --------------------------
UPLOADTHING_TOKEN=""

# --- Bonifico bancario --------------------------------------
BANK_TRANSFER_IBAN="IT00X0000000000000000000000"
BANK_TRANSFER_HOLDER="Materia Etrusca"
BANK_TRANSFER_BANK="Nome della banca"

# --- Operazioni pianificate (cron) --------------------------
# Segreto condiviso per proteggere le rotte /api/cron/*
CRON_SECRET=""

# --- Misurazione delle visite (facoltativa) -----------------
# Script caricato SOLO dopo il consenso ai cookie. Lasciando vuoto
# non viene caricato nulla e il sito non misura niente.
NEXT_PUBLIC_ANALYTICS_SRC=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# --- Opzionali ----------------------------------------------
# Solo in sviluppo: entra nel pannello /admin senza configurare le email.
# In produzione questa variabile non ha alcun effetto.
ADMIN_DEV_EMAIL=""

# Disattiva l'invio reale delle email: le stampa soltanto in console.
EMAIL_DRY_RUN="false"
